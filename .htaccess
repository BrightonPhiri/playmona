# PlayMona: Apache rules for the site root (nginx sits in front; see docs/deploy.md).
# nginx maps /play and /privacy itself and passes other addresses on to Apache.
Options -Indexes
RewriteEngine On

# Uploaded files (profile photos) are never run as code.
RewriteRule ^uploads/.*\.(php\d?|phtml|phar|cgi|pl|py)$ - [F,L,NC]

# Watch links: /watch/<8-character code> opens the watch page (it reads the code itself).
RewriteRule ^watch/([A-Za-z0-9]{8})/?$ watch.html [L]

# Clean addresses for pages nginx does not list by name: /terms -> terms.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# PlayMona's own pages instead of the server's plain error pages.
# A missing page and a forbidden folder look the same to players.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /error.html
ErrorDocument 502 /error.html
ErrorDocument 503 /error.html
ErrorDocument 504 /error.html
